# Copy this file to .env and fill in your values.
# Without VITE_JIRA_BASE_URL, the dashboard runs on mock data.

# Base URL of your JIRA Server instance (no trailing slash)
VITE_JIRA_BASE_URL=https://jira.yourcompany.com

# Optional: JIRA project key for scoped JQL queries
# If omitted, links use "project is not EMPTY" (all projects)
VITE_JIRA_PROJECT_KEY=RELEASE
