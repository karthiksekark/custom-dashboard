# Copy this file to .env and fill in your values.
# Restart the dev server or rebuild after any change.

# ── Required for live JIRA data ───────────────────────────────────────────────
# Base URL of your JIRA instance — no trailing slash.
# Without this, the extension runs in demo mode using built-in mock data.
# Examples:
#   VITE_JIRA_BASE_URL=https://your-org.atlassian.net   (Jira Cloud)
#   VITE_JIRA_BASE_URL=https://jira.yourcompany.com     (Jira Server)
VITE_JIRA_BASE_URL=

# ── Optional ──────────────────────────────────────────────────────────────────
# Restricts every JQL query to a single project key.
# If omitted, queries run across all projects ("project is not EMPTY").
# Example: VITE_JIRA_PROJECT_KEY=DIGOPS
VITE_JIRA_PROJECT_KEY=
